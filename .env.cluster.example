# Public entry point
GATEWAY_PORT=38008

# Shared PostgreSQL
PG_DB=ai_gateway
PG_USER=ai_gateway
PG_PASSWORD=replace-with-a-long-random-database-password
PG_POOL_MAX=15
PG_POOL_MIN=3

# Shared Redis
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_DATABASE=0

# Local Compose first boot. Production Kubernetes overrides these with validate + Flyway.
HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=false

# Identical secrets on every gateway replica
JWT_SECRET=replace-with-at-least-32-random-bytes
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
GATEWAY_API_KEY=sk-replace-with-a-long-random-bootstrap-key

# Cluster behaviour
CONFIG_SYNC_INTERVAL_MS=3000
DISTRIBUTED_RATE_LIMIT_ENABLED=true
DISTRIBUTED_RATE_LIMIT_FAIL_OPEN=false
DISTRIBUTED_RATE_LIMIT_TIMEOUT_MS=250

# Monthly campus quota policy (tokens)
STUDENT_MONTHLY_TOKEN_QUOTA=1000000
STAFF_MONTHLY_TOKEN_QUOTA=3000000
TEACHER_MONTHLY_TOKEN_QUOTA=5000000
QUOTA_TIME_ZONE=Asia/Shanghai

# School CAS 2.0. Enable only after registering the exact callback URL and real typeCode mappings.
CAMPUS_AUTH_ENABLED=false
CAMPUS_CAS_BASE_URL=https://cas.ntit.edu.cn/cas/
CAMPUS_PUBLIC_BASE_URL=https://ai.example.edu
CAMPUS_SESSION_TIMEOUT=30m
CAMPUS_SESSION_STORE_TYPE=redis
CAMPUS_SESSION_NAMESPACE=jairouter:session
CAMPUS_SESSION_COOKIE_SECURE=true
CAMPUS_ADMIN_ACCOUNTS=
EMERGENCY_LOGIN_ENABLED=false
EMERGENCY_LOGIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# 配置反向代理/Ingress 网段后才会信任其转发的客户端 IP
EMERGENCY_LOGIN_TRUSTED_PROXY_CIDRS=
# JAIROUTER_CAMPUS_AUTH_TYPE_ROLE_MAPPINGS_REAL_TEACHER_CODE_0=TEACHER
# JAIROUTER_CAMPUS_AUTH_TYPE_ROLE_MAPPINGS_REAL_STUDENT_CODE_0=STUDENT

TEACHER_ACCESS_ENABLED=false
TEACHER_REQUIRE_CLIENT_CERTIFICATE=true
TEACHER_TOKEN_SECRET=replace-with-at-least-32-random-bytes
TEACHER_TOKEN_ISSUER=https://ai.example.edu
TEACHER_TOKEN_AUDIENCE=ai-gateway
TEACHER_PUBLIC_BASE_URL=https://ai.example.edu
TEACHER_ACCESS_TOKEN_TTL=5m
TEACHER_MAX_DEVICES=2
# Container sizing; reduce this value if the host has less memory
JAVA_OPTS=-Xms1g -Xmx4g -XX:+UseG1GC -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
TZ=Asia/Shanghai

