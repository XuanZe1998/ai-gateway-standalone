# Host ports
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=38008
PG_EXPOSE_PORT=35433

# Public HTTPS entry (used by docker-compose.public.yml); fill with your actual DNS name
PUBLIC_DOMAIN=

# Standalone PostgreSQL
PG_DB=ai_gateway
PG_USER=ai_gateway
PG_PASSWORD=change-this-database-password

# Gateway credentials - change before exposing the service
JWT_SECRET=change-this-jwt-secret-at-least-32-characters-long
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-admin-password
GATEWAY_API_KEY=sk-change-this-api-key

# JWT lifetime
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# School CAS login (enable after registering the public callback with the school)
CAMPUS_AUTH_ENABLED=false
CAMPUS_CAS_BASE_URL=https://cas.ntit.edu.cn/cas/
CAMPUS_PUBLIC_BASE_URL=
CAMPUS_SESSION_TIMEOUT=30m
CAMPUS_SESSION_STORE_TYPE=none
CAMPUS_SESSION_NAMESPACE=jairouter:session
CAMPUS_SESSION_COOKIE_SECURE=true
CAMPUS_ADMIN_ACCOUNTS=
# Temporary: grant ADMIN to all CAS users (unsafe on public deployments).
CAMPUS_DEFAULT_ADMIN=true
# Temporary CAS-only bypass; paid providers still incur real upstream costs.
CAMPUS_UNRESTRICTED_ACCESS=false
EMERGENCY_LOGIN_ENABLED=false
EMERGENCY_LOGIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# 配置反向代理/Ingress 网段后才会信任其转发的客户端 IP
EMERGENCY_LOGIN_TRUSTED_PROXY_CIDRS=
# Teacher portal and short-lived ntit_at_ token
TEACHER_ACCESS_ENABLED=false
TEACHER_REQUIRE_CLIENT_CERTIFICATE=true
TEACHER_TOKEN_SECRET=change-this-independent-teacher-token-secret-at-least-32-bytes
TEACHER_TOKEN_ISSUER=https://ai.ntit.edu.cn
TEACHER_TOKEN_AUDIENCE=ai-gateway
TEACHER_PUBLIC_BASE_URL=https://ai.ntit.edu.cn
TEACHER_ACCESS_TOKEN_TTL=5m
TEACHER_MAX_DEVICES=2
TZ=Asia/Shanghai

